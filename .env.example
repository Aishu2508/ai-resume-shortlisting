# ---------- Database (candidates persist here across restarts) ----------
# Default: local SQLite file, zero setup required.
DATABASE_URL=sqlite:///./candidates.db
# To use Postgres instead, uncomment and fill in:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/recruitment_db

# ---------- LLM Provider (used to parse resumes into structured fields) ----------
# Supported: "openai" or "gemini"
LLM_PROVIDER=openai

OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-1.5-flash

# ---------- Embeddings (used for semantic_similarity scoring) ----------
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ---------- Storage ----------
UPLOAD_DIR=uploads

# ---------- Scoring weights (must sum to 1.0) ----------
WEIGHT_SKILL_MATCH=0.5
WEIGHT_SEMANTIC_SIMILARITY=0.2
WEIGHT_INTERVIEW_SCORE=0.3
